# TrustBazaar production settings (Unit 9). Copy to prod.env, fill every value, keep it out of git.
# Generate each secret with:  openssl rand -base64 48
# Development needs none of this: `docker compose up --build` uses development-only values.

# ---- origin and modes
PUBLIC_ORIGIN=https://trustbazaar.example
PAYMENT_MODE=sandbox          # mock | sandbox (C-2: the academic deliverable never takes real money)
COURIER_MODE=mock             # mock | sandbox (C-3)
SMS_MODE=log                  # log | provider test mode
TB_VERSION=1.0.0
TB_HTTP_PORT=8080
VITE_PAYMENT_HOSTS=           # exact provider page hosts, comma-separated (Unit 8, checkProviderRedirect)

# ---- database and cache (Unit 9, SEC-INF-02, SEC-INF-03)
POSTGRES_PASSWORD=            # superuser; used only by the container's first start
TB_OWNER_PASSWORD=            # migrations
TB_APP_PASSWORD=              # the application
REDIS_PASSWORD=

# ---- Unit 1 (SEC-DAT-05: each at least 32 bytes; rotation rules in Unit 1, Section 7)
JWT_KEY_V1=
FIELD_KEY_V1=
BIDX_KEY=
KYC_KEK_V1=
CSRF_KEY=
LINK_KEY=
OTP_PEPPER=

# ---- Unit 2 (payments) and Unit 4 (delivery)
CALLBACK_STATE_KEY=
HANDOVER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
COURIER_API_KEY=
COURIER_WEBHOOK_SECRET=

# ---- Unit 6 (messages)
SMTP_URL=
SMS_API_KEY=
