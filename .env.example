# ---- Core ----
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://trustbazaar:trustbazaar@postgres:5432/trustbazaar
POSTGRES_USER=trustbazaar
POSTGRES_PASSWORD=trustbazaar
POSTGRES_DB=trustbazaar

# ---- Redis (auction countdown state, bid locks, pub/sub, rate limiting) ----
REDIS_URL=redis://redis:6379

# ---- Payment: bKash sandbox ----
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# ---- Payment: Nagad sandbox ----
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com

# ---- Payment: Stripe test mode ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Courier (sandbox or mock) ----
COURIER_PROVIDER=mock          # mock | pathao | steadfast
COURIER_API_KEY=
COURIER_BASE_URL=

# ---- Terms of use and privacy notice (FR-ACC-04) ----
# Sign-up must send the current versions. The web client has them as build-time values, so each
# VITE_ value must equal the backend value next to it (Decisions log, U8-02).
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-01
VITE_TERMS_VERSION=2026-11-01
VITE_PRIVACY_VERSION=2026-11-01

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3000
