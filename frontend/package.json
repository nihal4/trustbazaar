{
  "name": "trustbazaar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:lighthouse": "node e2e/lighthouse.mjs",
    "mantine:css": "UPDATE_MANTINE_CSS=1 vitest run src/shared/theme.test.tsx",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,mjs}\" \".storybook/*.{ts,tsx}\" \"*.{js,mjs,cjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,mjs}\" \".storybook/*.{ts,tsx}\" \"*.{js,mjs,cjs,ts}\"",
    "dup": "jscpd",
    "unused": "knip --no-exit-code",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "health": "npm run lint --silent; npm run lint:css --silent; npm run dup --silent; npm run unused --silent; npm run deps --silent",
    "visual": "sh e2e/visual/run.sh",
    "visual:update": "sh e2e/visual/run.sh --update-snapshots",
    "health:ratchet": "node ../scripts/health-ratchet.mjs",
    "health:baseline": "node ../scripts/health-ratchet.mjs --update"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/hind-siliguri": "5.3.0",
    "@hpke/core": "1.9.0",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@tanstack/react-query": "5.59.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "4.1.12",
    "chrome-launcher": "1.2.3",
    "dependency-cruiser": "18.9.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-sonarjs": "4.2.3",
    "globals": "17.13.0",
    "jscpd": "5.4.3",
    "jsdom": "26.1.0",
    "knip": "6.48.0",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "storybook": "10.6.9",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.72.1",
    "vite": "^7.3.6",
    "vitest": "4.1.12"
  }
}
