{
  "name": "trustbazaar-backend",
  "version": "0.1.0",
  "description": "TrustBazaar core API \u2014 auth, listings, auctions, orders, payments/escrow, delivery, chat, disputes",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "posttest": "ts-node test/tools/coverage-gate.ts",
    "test:integration": "jest --config test/jest.integration.json --runInBand",
    "migrate": "node dist/migrate.js",
    "staff:bootstrap": "node dist/staff-bootstrap.js",
    "dev:mailbox": "node dist/dev-mailbox.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "1.4.7",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "9.0.2",
    "libphonenumber-js": "1.13.15",
    "otplib": "12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "socket.io": "^4.7.5",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test/tools"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.module\\.ts$",
      "/ports/index\\.ts$",
      "/db/entities/",
      "/db/enums\\.ts$",
      "/migrations/",
      "/main\\.ts$"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "multer": "2.5.0",
    "lodash": "4.18.1",
    "@angular-devkit/core": {
      "picomatch": "4.0.7"
    },
    "external-editor": {
      "tmp": "0.2.7"
    },
    "@nestjs/cli": {
      "glob": "10.5.0"
    }
  }
}
