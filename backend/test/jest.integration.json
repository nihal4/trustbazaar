{
  "rootDir": "..",
  "roots": [
    "<rootDir>/test/api",
    "<rootDir>/test/db",
    "<rootDir>/test/concurrency",
    "<rootDir>/test/security"
  ],
  "testRegex": "\\.spec\\.ts$",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "workerIdleMemoryLimit": "1024MB"
}
